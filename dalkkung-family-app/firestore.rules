rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function allowlist() {
      return get(/databases/$(database)/documents/access/allowlist).data;
    }

    function approved() {
      return verified() && request.auth.token.email in allowlist().emails;
    }

    function admin() {
      return approved() && request.auth.token.email in allowlist().admins;
    }

    match /access/allowlist {
      allow get: if verified() && request.auth.token.email in resource.data.emails;
      allow list: if false;
      allow create, delete: if false;
      allow update: if verified()
        && request.auth.token.email in resource.data.admins
        && request.resource.data.admins == resource.data.admins
        && request.resource.data.emails.size() <= 8
        && request.resource.data.emails.hasAll(resource.data.admins);
    }

    match /families/{familyId} {
      allow read, create, update: if approved() && familyId == 'dalkkung';
      allow delete: if false;

      match /care_events/{eventId} {
        allow read, create: if approved() && familyId == 'dalkkung';
        allow update: if approved()
          && familyId == 'dalkkung'
          && (admin() || resource.data.created_by == request.auth.uid)
          && request.resource.data.created_by == resource.data.created_by;
        allow delete: if approved()
          && familyId == 'dalkkung'
          && (admin() || resource.data.created_by == request.auth.uid);
      }

      match /attachments/{attachmentId} {
        allow read, create: if approved() && familyId == 'dalkkung';
        allow update: if approved()
          && familyId == 'dalkkung'
          && (admin() || resource.data.created_by == request.auth.uid)
          && request.resource.data.created_by == resource.data.created_by;
        allow delete: if approved()
          && familyId == 'dalkkung'
          && (admin() || resource.data.created_by == request.auth.uid);
      }

      match /{collectionName}/{documentId} {
        allow read, create: if approved() && familyId == 'dalkkung';
        allow update: if approved()
          && familyId == 'dalkkung'
          && collectionName != 'care_events'
          && collectionName != 'attachments';
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
